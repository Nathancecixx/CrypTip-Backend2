  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-dist",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "emitDeclarationOnly": false,
    "sourceMap": false
  },
  "include": [
    "app/api/jobs/reconcile/route.ts",
    "src/lib/**/*.ts",
    "tests/**/*.ts"

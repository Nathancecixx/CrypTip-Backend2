# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
RPC_PRIMARY_URL=https://rpc.helius.xyz/?api-key=YOUR_KEY
RPC_FALLBACK_URL=https://api.mainnet-beta.solana.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sk_service_...

# Auth / Cookies
# Must be at least 32 bytes
SESSION_SECRET=replace_with_32+_bytes_secret
SIWS_DOMAIN=cryptip.org                 # Hostname that renders the login page for this environment
COOKIE_NAME=ctj_sess
FRONTEND_ORIGIN=http://localhost:3001      # Origin of the frontend calling the API (swap to your Vercel URL in prod)
# Comma-separated list of allowed CORS origins. Include localhost plus staging + prod frontends that call this backend directly.
ALLOWED_ORIGINS=http://localhost:3001,https://cryptip-frontend.vercel.app,https://cryptip.org
# Legacy fallback if needed
# ORIGIN_ALLOWLIST=http://localhost:3000,https://cryptip.org,https://www.cryptip.org
# Legacy fallback if needed
# SESSION_COOKIE_NAME=ctj_sess
# JWT_SECRET=replace_with_32+_bytes_secret

# x402
X402_WEBHOOK_SECRET=replace_with_webhook_secret

# Minting
MINT_COLLECTION_ADDRESS=YourCollectionAddress
MINT_SIGNER_SECRET=base58_private_key   # (upgrade to KMS later)
ENABLE_FAKE_MINT=1                      # dev flag; prod remove or set 0

# Optional: Upstash Rate Limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
